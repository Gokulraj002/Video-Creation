# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/video_creation
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Used by the panel and any API client: Authorization: Bearer <key>
ADMIN_API_KEY=change-me
# Public URL of the API. WhatsApp downloads videos from here when STORAGE_DRIVER=local,
# so it must be reachable from the internet (ngrok / cloudflared in dev).
PUBLIC_BASE_URL=http://localhost:4000
DEFAULT_COUNTRY_CODE=91

# --- Storage: local | s3 (S3, Cloudflare R2, DigitalOcean Spaces, MinIO) ---
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://videos.yourdomain.com
S3_PUBLIC_URL=

# --- Rendering ---
RENDER_CONCURRENCY=1
# Optional: path to Chrome / chrome-headless-shell. Remotion downloads one if empty.
CHROME_EXECUTABLE=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Voice (optional, ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- WhatsApp Cloud API (leave token empty for dry-run mode) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SEND_RATE_PER_SEC=20
