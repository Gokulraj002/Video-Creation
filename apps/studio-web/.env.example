# Studio web (Next.js) — server-side only. Never prefix these with NEXT_PUBLIC_: the token must not reach the browser.

# Base URL of @vc/studio-api (Fastify).
STUDIO_API_URL=http://localhost:4100

# Bearer token for the studio API (e.g. the STUDIO_DEV_API_TOKEN you seeded with `pnpm studio:db:seed`).
STUDIO_API_TOKEN=
