{
  "name": "@vc/studio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal AI Video Studio API (Fastify + Prisma + BullMQ)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vc/ai-director": "workspace:*",
    "@vc/schema": "workspace:*",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
