# =============================================================================================
# @vc/studio-api — Universal AI Video Studio API + director worker
# Copy to apps/studio-api/.env (loaded by `pnpm dev`, `pnpm dev:worker`, `pnpm db:seed`).
# Empty values mean "unset" (the default applies).
# =============================================================================================

# --- Runtime -----------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
STUDIO_API_HOST=0.0.0.0
STUDIO_API_PORT=4100
# fatal | error | warn | info | debug | trace | silent  (Authorization headers and API keys are redacted)
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS (studio-web dev server by default)
CORS_ORIGINS=http://localhost:3000

# --- Storage / queue ---------------------------------------------------------------------------
# PostgreSQL (Prisma). Tests use TEST_DATABASE_URL (default .../video_studio_test) instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/video_studio
# pg pool size of each process (API and worker each have one) and how long a query may wait for a free
# connection before failing (ms) instead of hanging
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
# bullmq = API enqueues to Redis queue "studio-director" and `pnpm dev:worker` processes runs (recommended)
# inline = runs execute inside the API process (single-process development only; no Redis needed)
QUEUE_DRIVER=bullmq
# An enqueue (or queue lookup / readiness ping) that cannot reach Redis within this budget fails (ms):
# POST .../director-runs then answers 503 QUEUE_UNAVAILABLE and the run is recorded FAILED (not counted
# toward LIMIT_DIRECTOR_RUNS_PER_DAY). GET /ready reports Redis as "error".
QUEUE_ENQUEUE_TIMEOUT_MS=3000

# --- AI provider -------------------------------------------------------------------------------
# mock = deterministic heuristic director, no network, no credits (default)
# anthropic = Claude via the Anthropic API (requires ANTHROPIC_API_KEY)
AI_PROVIDER=mock
# Required iff AI_PROVIDER=anthropic. Never logged, never returned by /v1/system/config.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Per-request output cap (256..16000; the director chunks long videos so outputs stay small)
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# default = server-side refusal fallbacks on; off = disabled
ANTHROPIC_FALLBACKS=default
# json_schema = structured outputs (recommended); prompt = JSON schema embedded in the prompt
ANTHROPIC_STRUCTURED_OUTPUT=json_schema

# --- AI Director -------------------------------------------------------------------------------
# Extra repair attempts per stage call when output fails validation
DIRECTOR_MAX_REPAIR_ATTEMPTS=2
# Minimum wall-clock budget for one director run (ms); exceeded runs fail with error code TIMEOUT.
# The effective timeout scales with the plan: max(DIRECTOR_RUN_TIMEOUT_MS, steps x DIRECTOR_STEP_TIMEOUT_MS)
# where steps = 2 + 5 x chapters + 1 (e.g. a 2 h long-form video = 25 chapters = 128 steps -> ~4.3 h with the
# defaults; a 2 h social-short = 84 chapters = 423 steps). Both values and the scaled result are capped at
# 2147483647 ms (~24.8 days, the largest timer Node.js supports).
DIRECTOR_RUN_TIMEOUT_MS=1800000
# Per-step budget used for that scaling (ms); 0 disables scaling
DIRECTOR_STEP_TIMEOUT_MS=120000
# on = validated stage outputs are cached in Postgres (identical re-runs cost 0 tokens); off = no cache
DIRECTOR_CACHE=on
# Optional JSON overriding/adding model pricing (USD per million tokens), merged over the built-in table, e.g.
# {"claude-opus-5-5":{"inputPerMTok":4,"outputPerMTok":20,"cacheReadPerMTok":0.2,"cacheWritePerMTok":5}}
DIRECTOR_PRICING_JSON=
# Parallel director runs per worker process
DIRECTOR_WORKER_CONCURRENCY=2
# BullMQ job lock (ms, >= 30000): a worker that cannot reach Redis for longer has its job counted as stalled
# (the run is then failed only if its heartbeat is stale too). BullMQ's own default is 30 s.
DIRECTOR_JOB_LOCK_MS=300000
# Running runs write a heartbeat every ~2 s. A RUNNING run whose heartbeat is older than this (ms) is failed
# with WORKER_LOST by the reaper (partial usage kept, project status restored).
DIRECTOR_HEARTBEAT_STALE_MS=60000
# A QUEUED run older than this (ms) whose queue job is missing/failed is failed with QUEUE_LOST (never re-queued).
DIRECTOR_QUEUED_STALE_MS=600000
# How often the reaper runs (ms) in the worker (and in the API with QUEUE_DRIVER=inline); 0 disables it.
DIRECTOR_REAPER_INTERVAL_MS=30000
# On SIGTERM/SIGINT in-flight runs stop and are recorded FAILED with code SHUTDOWN (they are not re-queued;
# starting them again is cheap because completed stages are cached).

# --- Resource limits (configurable, not hardcoded maxima) ---------------------------------------
LIMIT_MAX_DURATION_SECONDS=7200
LIMIT_MAX_WIDTH=3840
LIMIT_MAX_HEIGHT=3840
LIMIT_MAX_FPS=60
LIMIT_MAX_SCENES=2000
LIMIT_MAX_CHAPTERS=200
# Optional (defaults shown): tracks per timeline / assets per timeline or request
LIMIT_MAX_TRACKS=50
LIMIT_MAX_ASSETS=500
LIMIT_MAX_PROMPT_CHARS=20000

# --- Quotas / abuse protection -----------------------------------------------------------------
# Per user per UTC day; POST /v1/projects/:id/director-runs returns 429 QUOTA_EXCEEDED when reached
LIMIT_DIRECTOR_RUNS_PER_DAY=50
# Daily AI spend per user (USD). A start is refused when today's spend + the cost ceilings reserved by the
# user's queued/running runs + this run's ceiling would exceed it. The ceiling assumes every stage call
# produces its max output tokens (plus an input budget): on claude-opus-5-5 ~$0.48 + $1.84 per chapter, e.g.
# a 30 s promo $2.32, a 1 h long-form video (13 chapters) $24.40, a 2 h long-form video (25 chapters) $46.48,
# so raise this limit for long videos on large models. The mock provider costs 0. A running run is also
# stopped with QUOTA_EXCEEDED once today's actual spend reaches the limit.
LIMIT_DIRECTOR_USD_PER_DAY=25
# Queued + running director runs per user across all projects (429 QUOTA_EXCEEDED beyond)
LIMIT_ACTIVE_RUNS_PER_USER=2
# Requests per minute per authenticated user (all of the user's tokens share it)
RATE_LIMIT_PER_MINUTE=300
# Failed authentications (missing/invalid/revoked token) per minute per client IP; beyond it every /v1
# request from that IP gets 429 without a database lookup until the window resets
RATE_LIMIT_UNAUTH_PER_MINUTE=60

# --- Caching ---------------------------------------------------------------------------------------
# Byte budget of the in-process cache of serialized project versions (immutable; served with an ETag and
# Cache-Control: immutable). 0 disables the cache (every view re-reads and re-validates the stored version).
VERSION_CACHE_MAX_BYTES=67108864

# --- Development auth --------------------------------------------------------------------------
# `pnpm db:seed` upserts this user and stores the sha256 hash of STUDIO_DEV_API_TOKEN.
STUDIO_DEV_USER_EMAIL=dev@localhost
# At least 32 characters; used ONLY by the seed script. Generate one with:
#   node -e "console.log('vcs_' + require('crypto').randomBytes(32).toString('base64url'))"
# Then use the same value as STUDIO_API_TOKEN in apps/studio-web/.env.
STUDIO_DEV_API_TOKEN=
